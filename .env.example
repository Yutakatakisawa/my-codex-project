# ===========================================
# AI Employee System - 環境変数
# ===========================================
# ※ APIキーなしでもデモモードで動作します
# ※ 取得方法は GUIDE.md を参照

# ------------------------------------------
# [推奨] Anthropic (Jarvis/Max/Sam が使用)
# 取得: https://console.anthropic.com/
# ------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------
# [推奨] Google Gemini (Pixel/Riley が使用)
# 取得: https://aistudio.google.com/apikey
# ------------------------------------------
GOOGLE_API_KEY=

# ------------------------------------------
# [任意] OpenAI (Nova が使用)
# 取得: https://platform.openai.com/api-keys
# ------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------
# [任意] GLM / ZhipuAI (Alice/Quinn が使用)
# 取得: https://open.bigmodel.cn/
# ------------------------------------------
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ------------------------------------------
# [任意] Firecrawl (Alice のウェブスクレイピング)
# 取得: https://firecrawl.dev/
# ------------------------------------------
FIRECRAWL_API_KEY=

# ------------------------------------------
# [任意] Telegram (Jarvis からのリアルタイム報告)
# 取得: @BotFather → /newbot
# ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------
# ダッシュボード設定
# ------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# ------------------------------------------
# システム設定
# ------------------------------------------
LOG_LEVEL=INFO
MAX_CONCURRENT_AGENTS=7
AGENT_HEARTBEAT_INTERVAL=30
